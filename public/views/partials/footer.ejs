<div class="overlay" id="cartOverlay"></div>
<aside class="sidebar cart-sidebar" id="cartSidebar">
  <div class="sidebar-head"><h3>Shopping Cart</h3><button class="close-btn" id="cartClose">&times;</button></div>
  <div class="sidebar-body" id="cartItems"><p class="empty-msg">Your cart is empty</p></div>
  <div class="sidebar-foot">
    <div class="cart-sum"><span>Subtotal:</span><strong id="cartTotal">৳ 0</strong></div>
    <button class="btn-checkout" id="checkoutBtn">Proceed to Checkout</button>
    <a href="https://wa.me/<%= config.whatsapp %>" class="btn-whatsapp" target="_blank">Order via WhatsApp</a>
  </div>
</aside>

<div class="overlay" id="modalOverlay"></div>
<div class="product-modal" id="productModal">
  <button class="close-btn modal-close" id="modalClose">&times;</button>
  <div class="modal-body" id="modalBody"></div>
</div>
<div class="toast" id="toast"></div>

<script src="/js/main.js"></script>
</body>
</html>

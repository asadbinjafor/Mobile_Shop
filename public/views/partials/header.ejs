<div class="marquee-bar">
  <div class="marquee-track">
    <span>🔥 Mega EID Fest — 0% EMI | Upto ৳25,000 Cashback | Free Delivery</span>
    <span>📱 Latest iPhone, Samsung, Xiaomi at Best Price in BD</span>
    <span>✅ 100% Genuine Products | 36 Months Installment</span>
    <span>🔥 Mega EID Fest — 0% EMI | Upto ৳25,000 Cashback | Free Delivery</span>
  </div>
</div>

<div class="top-bar">
  <div class="container top-bar-inner">
    <div class="top-left">
      <a href="tel:+88<%= config.phone.replace(/^0/,'') %>">📞 Hotline: <%= config.phone %></a>
      <a href="#">📍 Store Locator</a>
      <a href="#">🚚 Track Order</a>
    </div>
    <div class="top-right">
      <a href="#">Login</a><span>|</span>
      <a href="#">Register</a><span>|</span>
      <a href="/#flash-sale">Offers</a>
    </div>
  </div>
</div>

<header class="header">
  <div class="container header-main">
    <button class="hamburger" id="hamburger" aria-label="Menu"><span></span><span></span><span></span></button>
    <a href="/" class="logo">
      <div class="logo-mark">M</div>
      <div class="logo-name"><strong>MobileHub</strong><small>Best Price in BD</small></div>
    </a>
    <form class="search-wrap" action="/products" method="GET">
      <select class="search-cat" name="category" aria-label="Category">
        <option value="">All Categories</option>
        <option value="phones">Phones</option>
        <option value="laptops">Laptop</option>
        <option value="gadgets">Gadget</option>
      </select>
      <input type="search" name="q" id="searchInput" placeholder="Search for products, brands..." value="<%= typeof query !== 'undefined' ? query : '' %>">
      <button class="search-btn" type="submit" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </button>
    </form>
    <div class="header-icons">
      <a href="/products" class="h-icon" title="All Products"><span>Shop</span></a>
      <a href="#" class="h-icon" id="wishlistBtn" title="Wishlist">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span>Wishlist</span><em class="badge-sm" id="wishCount">0</em>
      </a>
      <a href="#" class="h-icon cart-icon" id="cartBtn" title="Cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span>Cart</span><em class="badge-sm cart-badge" id="cartCount">0</em>
      </a>
    </div>
  </div>
  <nav class="main-nav" id="mainNav">
    <div class="container nav-wrap">
      <div class="nav-item nav-offer-link"><a href="/#flash-sale" class="nav-link offer-tab">🔥 OFFER</a></div>
      <div class="nav-item has-mega">
        <a href="/category/phones" class="nav-link">Phones <span class="arrow">▾</span></a>
        <div class="mega-menu"><div class="mega-col">
          <% brands.forEach(b => { %><a href="/products?brand=<%= b.slug %>"><%= b.name %></a><% }) %>
        </div></div>
      </div>
      <div class="nav-item"><a href="/category/tablets" class="nav-link">Tablet</a></div>
      <div class="nav-item"><a href="/category/laptops" class="nav-link">Laptop</a></div>
      <div class="nav-item"><a href="/category/smartwatch" class="nav-link">Smart Watch</a></div>
      <div class="nav-item"><a href="/category/gadgets" class="nav-link">Gadget</a></div>
      <div class="nav-item"><a href="/category/accessories" class="nav-link">Accessories</a></div>
      <div class="nav-item"><a href="/category/sounds" class="nav-link">Sounds</a></div>
      <div class="nav-item"><a href="/category/smarttv" class="nav-link">Smart TV</a></div>
    </div>
  </nav>
</header>
